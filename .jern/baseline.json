{
  "//": "The protected baseline. The Jern Action reads it from the base commit of a pull request, and Jern Cloud pins it by digest for the life of a session, so neither a pull request nor a session can weaken it.",
  "policy": {
    "allow": [
      "edit_file",
      "edit_symbol",
      "apply_patch",
      "write_file",
      "mcp__jern__start_service",
      "mcp__jern__read_issue",
      "mcp__jern__list_issues",
      "mcp__jern__read_pull_request",
      "mcp__jern__read_check_log",
      "mcp__jern__ask_human",
      "mcp__jern__fetch_page",
      "mcp__jern__package_info",
      "mcp__jern__recall_claims",
      "mcp__jern__record_claim",
      "mcp__jern__browser_open",
      "mcp__jern__browser_read",
      "mcp__jern__browser_click",
      "mcp__jern__browser_type",
      "mcp__jern__browser_press",
      "mcp__jern__browser_wait",
      "mcp__jern__browser_evaluate",
      "mcp__jern__browser_screenshot",
      "mcp__jern__browser_console",
      "mcp__jern__browser_close"
    ],
    "edits_within": [
      "src/",
      "tests/",
      "web/"
    ],
    "protected_paths": [
      ".jern/",
      ".github/"
    ],
    "max_files_edited": 4,
    "max_lines_changed": 200,
    "memory": "allow",
    "shell_allow": [
      "python3 -m unittest discover -s tests -t .",
      "python3"
    ]
  },
  "environment": {
    "services": [
      "postgres:16"
    ],
    "network_allow": [
      "docs.python.org"
    ]
  },
  "test_command": "python3 -m unittest discover -s tests -t ."
}
